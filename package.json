{
  "name": "dsh-ember",
  "version": "0.1.0",
  "description": "推理等级变成滑块，完全权限变红 | Reasoning effort as a slider, full access in red — composer enhancement for DeepSeek Harness",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "deepseek",
    "dsh-ui",
    "plugin",
    "permission",
    "full-access",
    "reasoning-effort",
    "reasoning",
    "effort",
    "slider",
    "composer",
    "ui",
    "theme",
    "animation",
    "cordis",
    "推理等级",
    "完全权限",
    "滑块",
    "输入区",
    "界面增强",
    "插件"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "screenshots.json",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REALOIYO/dsh-ember.git"
  },
  "homepage": "https://github.com/REALOIYO/dsh-ember#readme",
  "bugs": {
    "url": "https://github.com/REALOIYO/dsh-ember/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
