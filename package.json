{
  "name": "dsh-ember",
  "version": "0.2.0",
  "description": "四件事一个插件：完全权限变红、推理等级滑块、模型菜单可辨识、会话状态环 | Full access in red, effort slider, legible model picker, session status ring — UI enhancement for DeepSeek Harness",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "deepseek",
    "dsh-ui",
    "plugin",
    "permission",
    "full-access",
    "reasoning-effort",
    "reasoning",
    "effort",
    "slider",
    "composer",
    "session",
    "sidebar",
    "status",
    "ring",
    "indicator",
    "animation",
    "ui",
    "theme",
    "cordis",
    "推理等级",
    "完全权限",
    "滑块",
    "状态环",
    "会话列表",
    "界面增强",
    "插件"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "screenshots.json",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REALOIYO/dsh-ember.git"
  },
  "homepage": "https://github.com/REALOIYO/dsh-ember#readme",
  "bugs": {
    "url": "https://github.com/REALOIYO/dsh-ember/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
